# Copy to .env.local. Never commit credentials. No VITE_ database or auth secrets.
# APP_ENV: local | preview | production. Production always disables demo data.
APP_ENV=
# true | false. Local defaults to demo; Preview requires explicit true.
DEMO_MODE=
APP_DATABASE_URL=
AUTH_DATABASE_URL=
WORKER_DATABASE_URL=
# Administrative migration connection; never used by the web request handler.
MIGRATION_DATABASE_URL=
# Used by db:migrate to verify the intended target (local | preview | production).
MIGRATION_TARGET=
# P02: exact public origin without trailing slash. Local Vite: http://localhost:5173.
# Production: https://iharu.vercel.app. Each Preview needs its own origin and test credentials.
APP_ORIGIN=
# Generate at least 32 random bytes. Never use a sample/default value.
BETTER_AUTH_SECRET=
# Optional providers are disabled until their required values are set.
# Resend: verified sending domain/address. Server-only.
RESEND_API_KEY=
MAIL_FROM=
# Register APP_ORIGIN/api/auth/callback/{google|kakao|naver} with each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# SOLAPI: approved domestic sender. Budget is a hard cap on send attempts per rolling 24h.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SMS_FROM=
SMS_DAILY_BUDGET=
